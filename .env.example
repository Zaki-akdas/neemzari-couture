# ───────────────────────────────────────────────────────────────
# Neemzari Couture — environment variables
# Copy to `.env.local` and fill in real values before production.
# ───────────────────────────────────────────────────────────────

# WhatsApp Business number used for the "Enquire via WhatsApp" links.
# Digits only, no "+" or spaces. Entry for +1 647-819-3146 is "16478193146".
# IMPORTANT: Verify this number is actually enabled for WhatsApp Business
# before launch.
NEXT_PUBLIC_WHATSAPP_NUMBER=16478193146

# Google Maps embed. You can leave the free "output=embed" query as-is,
# or use a Maps API key here for a richer embed.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED=https://www.google.com/maps?q=8887+The+Gore+Rd,%20Brampton,%20ON%20L6P%202K9&output=embed

# Recommended backend: Supabase (for enquiries, products, testimonials, hours).
# These are NOT wired yet — the project uses local data in /lib until enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contact form submission. When a route/backend handler is added, set the
# endpoint here. Until then the form shows the front-end success state only.
NEXT_PUBLIC_CONSULTATION_ENDPOINT=
